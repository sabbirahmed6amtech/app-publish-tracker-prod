# Copy to .env and fill in.

# Supabase Postgres. On Vercel use the transaction pooler (port 6543):
#   Supabase dashboard → Connect → Transaction pooler
# Local stack (`supabase start`): postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"

# Supabase Storage for keystore files and product-line logos (server-side only).
# Dashboard → Project Settings → API. Leave blank to keep files on disk (UPLOAD_DIR).
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""

# Signs login sessions. Any long random string: `openssl rand -base64 32`
AUTH_SECRET=""

# Where keystore (.jks) files and product-line logos are stored when Supabase
# Storage isn't configured (local only — Vercel's disk is not kept).
UPLOAD_DIR="./uploads"

# The key an external scheduler sends to /api/store-watch. Any long random string.
STORE_WATCH_KEY=""

# Vercel Cron sends this as a Bearer token to /api/store-watch. Any long random string.
CRON_SECRET=""

# The address the app is served at (used in links, e.g. the client form).
APP_URL="http://localhost:3000"

# --- Source-to-Drive export (client detail → "Export source") ---
# A GitHub token with read access to the repos you export. Best: an org-owned
# fine-grained token (Contents: Read + Metadata: Read) or a classic token with
# `repo` + `read:org`. Used server-side only.
GITHUB_TOKEN=""

# Limit the export's repo list to this GitHub org (e.g. 6amTech). Leave blank to
# show every repo the token can reach.
GITHUB_ORG="6amTech"

# Google OAuth Web client ID. Add this app's origin (e.g. http://localhost:3000)
# to its Authorized JavaScript origins. Exposed to the browser for Drive sign-in.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# The team's shared Drive folder the export uploads into (link or folder ID).
NEXT_PUBLIC_DRIVE_FOLDER_ID=""
